# Copy this file to .env and adjust values for your environment.
# .env is loaded automatically at startup if python-dotenv is installed.

# Flask
FLASK_DEBUG=true
PORT=5000

# Security — change these in production, use long random values
SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_SECRET=change-this-to-a-different-long-random-secret
JWT_EXP_MINUTES=60

# Default admin account (only used the first time the database is created)
ADMIN_EMAIL=admin@housekeepinghub.com
ADMIN_PASSWORD=admin123

# --- Persistent storage (recommended for Render / any host with ephemeral disks) ---

# PostgreSQL connection string from a free provider such as Neon.tech.
# Leave blank to use the local SQLite file instead (fine for local dev only —
# NOT persistent on hosts that wipe the disk on restart/redeploy).
# Example: postgresql://user:password@ep-xxxx.neon.tech/housekeeping?sslmode=require
DATABASE_URL=

# Cloudinary connection string (free tier) for persistent service-image
# uploads. Leave blank to save uploaded images to local disk instead (fine
# for local dev only — NOT persistent on hosts with ephemeral disks).
# Example: cloudinary://123456789012345:AbCdEfGhIjKlMnOpQrStUvWxYz@my-cloud-name
CLOUDINARY_URL=
